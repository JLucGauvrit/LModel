# ─────────────────────────────────────────────────────────────────────────────
# World Model FPGA — configuration d'entraînement
# Copier ce fichier en .env et ajuster les valeurs selon votre setup.
# ─────────────────────────────────────────────────────────────────────────────

# ── GPU ───────────────────────────────────────────────────────────────────────
# Indices des GPUs exposés aux conteneurs.
# trainer / tensorboard : les deux GPUs (GT 1030 = 0, RTX 2060 SUPER = 1)
# inference : surcharge à "1" dans docker-compose.yml pour le GPU le plus fort
CUDA_VISIBLE_DEVICES=0,1

# ── Architecture partagée (VAE · MDN-RNN · Controller) ───────────────────────
LATENT_DIM=256
HIDDEN_DIM=1024
ACTION_DIM=7
NUM_GAUSSIANS=8

# ── Collecte de données (1_collect_data.py) ───────────────────────────────────
# Environnements MiniGrid séparés par des virgules
COLLECT_ENVS=MiniGrid-Empty-8x8-v0,MiniGrid-FourRooms-v0,MiniGrid-DoorKey-5x5-v0,MiniGrid-SimpleCrossingS9N1-v0
TARGET_TRANSITIONS=200000
MAX_STEPS_PER_EPISODE=500
# Fraction des actions choisies de façon greedy vers le but (vs aléatoire)
GREEDY_EPSILON=0.3

# ── VAE (2_train_world.py — phase 1) ─────────────────────────────────────────
VAE_EPOCHS=80
VAE_BATCH=512
VAE_LR=0.001

# ── MDN-RNN (2_train_world.py — phase 2) ─────────────────────────────────────
MDNRNN_EPOCHS=80
MDNRNN_BATCH=256
MDNRNN_LR=0.001
SEQ_LEN=128

# ── Controller REINFORCE (3_train_controller.py) ──────────────────────────────
CTRL_NUM_ENVS=2048
CTRL_NUM_UPDATES=8000
CTRL_DREAM_STEPS=128
CTRL_GAMMA=0.99
CTRL_LR=0.0003
CTRL_ENTROPY_COEFF=0.01
CTRL_MAX_GRAD_NORM=1.0
CTRL_SAVE_EVERY=100
CTRL_REWARD_WINDOW=20
