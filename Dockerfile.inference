# --- Étape 1 : Builder ---
# torch CUDA 12.4 — même base que Dockerfile.trainer (layer partagée dans le cache Docker)
FROM python:3.10-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Layer stable : torch CUDA (~2.5 Go, partagée avec le builder du trainer)
RUN pip install --user --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cu124

# Layer légère : dépendances spécifiques à l'inférence
COPY requirements.inference.txt .
RUN pip install --user --no-cache-dir -r requirements.inference.txt

# --- Étape 2 : Runner ---
FROM python:3.10-slim AS runner

WORKDIR /app

COPY --from=builder /root/.local /root/.local
COPY src/ ./src/
COPY frontend/inference_ui.py ./frontend/inference_ui.py

ENV PATH=/root/.local/bin:$PATH
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# CUDA_VISIBLE_DEVICES est surchargé à "1" dans docker-compose.yml (RTX 2060 SUPER)

# Matplotlib sans display X11
ENV MPLBACKEND=Agg

EXPOSE 8080

CMD ["python", "frontend/inference_ui.py"]
